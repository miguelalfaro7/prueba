# Copia este archivo a .env y cambia las contraseñas para tu entorno local.
# Usa un usuario RabbitMQ distinto de guest.
RABBITMQ_USER=iot
RABBITMQ_PASSWORD=

POSTGRES_DB=iot_history
POSTGRES_USER=iot
POSTGRES_PASSWORD=

# Publicación HTTP/WebSocket en localhost.
IOT_PLANT_PORT=8081
IOT_OPERATOR_PORT=8082
IOT_DISPATCH_PORT=8083
IOT_HISTORY_PORT=8090

# Valor normal. Usa 15s solo en un proyecto aislado de prueba.
IOT_MAINTENANCE_DELAY=24h
